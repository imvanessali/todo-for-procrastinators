{
  "name": "folio",
  "compatibility_date": "2026-06-01",
  "main": "./worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // TODO(you): 部署到自有域名时取消注释并替换
  // "routes": [{ "pattern": "your-domain.com/*", "zone_name": "your-domain.com" }],
  "vars": {
    "SUPABASE_URL": "YOUR_SUPABASE_URL",        // TODO(you): https://xxx.supabase.co
    "SUPABASE_ANON_KEY": "YOUR_SUPABASE_ANON_KEY" // TODO(you): Supabase Dashboard → Settings → API
  }
}
